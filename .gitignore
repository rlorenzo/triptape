# Rust
/target/
**/*.rs.bk

# Node / frontend
node_modules/
dist/
.svelte-kit/

# Tauri
src-tauri/target/
# Sidecar executables (scripts/fetch-sidecars); only the README is tracked
src-tauri/binaries/*
!src-tauri/binaries/README.md
.sidecar-cache/
src-tauri/gen/

.boost/

# Impeccable critique reports are point-in-time and carry local paths
.impeccable/critique/

# Linter output
report/
.fallow/

# App data / outputs (never commit user media or exports)
*.sqlite
*.sqlite-*
cache/
output/
exports/
# Local model files (scripts/fetch-models); never committed
/models/
*.onnx

# OS / editors
.DS_Store
.idea/
.vscode/

# Secrets / signing (never commit)
*.key
*.pem
*.p12
.env
.env.*
!.env.example

# Browser-automation session logs and screenshots
.playwright-mcp/
