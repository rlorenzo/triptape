#!/usr/bin/env bash
# Fetch the pinned FFmpeg + ffprobe sidecars (full GPL static builds with
# libx264 + libvidstab, never --enable-nonfree) into src-tauri/binaries/ and
# run scripts/check-ffmpeg.sh on them. The pins (version, URLs, SHA-256) live
# in scripts/fetch-sidecars, which also fetches Typst; see docs/ffmpeg-build.md.
#
# Usage: ./scripts/fetch-ffmpeg [--target <triple>] [--out <dir>]
set -euo pipefail
exec "$(dirname "${BASH_SOURCE[0]}")/fetch-sidecars" ffmpeg "$@"
