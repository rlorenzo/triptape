{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "IPC for the main window: app commands, job progress events, the trip-folder picker, and opening finished exports.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$VIDEO/TripTape/**" }]
    }
  ]
}
